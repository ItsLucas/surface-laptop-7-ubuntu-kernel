[Unit]
Description=Publish signed SL7 kernel candidates from GitHub Releases
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=sl7repo
Group=sl7repo
EnvironmentFile=/etc/sl7-apt.conf
ExecStart=/usr/bin/python3 /opt/sl7-apt/sync.py --signing-key ${SIGNING_KEY}
TimeoutStartSec=20min
UMask=0022
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/sl7-apt

